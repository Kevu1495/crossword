{
  "name": "cozy-crossword",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python3 -m unittest discover -s generator/tests -v",
    "generate": "python3 generator/generate.py",
    "format": "prettier --write frontend/src worker/src docs README.md",
    "lint": "eslint frontend/src worker/src",
    "test:e2e": "playwright test",
    "build:cloudflare": "npm run typecheck && CLOUDFLARE_BUILD=true VITE_USE_API=true vite build && node scripts/prepare-cloudflare.mjs",
    "deploy": "npm run build:cloudflare && cf deploy --prebuilt --provision=false",
    "test:cloudflare": "node scripts/verify-cloudflare.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "cf": "^1.0.0-beta.29",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "miniflare": "5.20261110.0-beta"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "engines": {
    "node": ">=22.23.0"
  }
}
